msgstr ""

msgid "Weekly"
msgstr ""

msgid "Monthly"
msgstr ""

msgid "Yearly"
msgstr ""

msgid "Never"
msgstr ""

msgid "After"
msgstr ""

msgid "On date"
msgstr ""

msgid "Repeats"
msgstr ""

msgid "{count} times"
msgstr ""

msgid "Frequency"
msgstr ""

msgid "Every"
msgstr ""

msgid "Repeat on"
msgstr ""

msgid "Select days or leave empty to repeat on the same day as the start date"
msgstr ""

msgid "Ends"
msgstr ""

